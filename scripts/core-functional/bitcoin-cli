#!/usr/bin/env python3
"""Test-only bitcoin-cli → cookie JSON-RPC. Not the operator CLI.

`mining_template_verification.py` calls `node.cli.getblocktemplate(...)` in
parallel. Core's TestNodeCLI shells out to this binary. The cookie is read
from the same `regtest` / `signet` / `signet_<magic>` directory the bitcoind
shim hands the node.
"""

from __future__ import annotations

import json
import os
import sys
import urllib.error
import urllib.request
from pathlib import Path

from signet_datadir import chain_dir

SIGNET_HINT = "Is your -signetchallenge correct for custom signets?"


def parse_kv(arg: str) -> tuple[str, str | None]:
    a = arg[1:] if arg.startswith("-") else arg
    a = a[1:] if a.startswith("-") else a
    if "=" in a:
        k, v = a.split("=", 1)
        return k, v
    return a, None


def conf_value(datadir: Path, key: str) -> str | None:
    for name in ("bitcoin.conf", "regtest/bitcoin.conf"):
        p = datadir / name
        if not p.is_file():
            continue
        for line in p.read_text(encoding="utf-8", errors="replace").splitlines():
            line = line.strip()
            if not line or line.startswith("#") or "=" not in line:
                continue
            k, v = line.split("=", 1)
            if k.strip() == key:
                return v.strip()
    return None


def is_on(val: str | None) -> bool:
    return val is None or val.lower() in ("1", "true", "yes", "on")


def cookie_auth(datadir: Path, net_dir: str, cookiefile: str | None) -> str | None:
    """Core `-rpccookiefile`: a relative path is under the network directory."""
    if cookiefile is not None:
        paths = [datadir / net_dir / cookiefile]
    else:
        paths = [datadir / net_dir / ".cookie", datadir / ".cookie"]
    for p in paths:
        if p.is_file():
            return p.read_text(encoding="utf-8").strip()
    return None


def auth_failed(datadir: Path, cookie_read: bool, password: bool, signet: bool) -> str:
    """Core's bitcoin-cli HTTP 401 text, with its signet hint."""
    if password:
        why = "Incorrect rpcuser or rpcpassword were specified."
    elif cookie_read:
        why = "Cookie file credentials were invalid and no rpcpassword was specified."
    else:
        why = "Failed to read cookie file and no rpcpassword was specified."
    text = f"Authorization failed: {why} Configuration file: ({datadir / 'bitcoin.conf'})"
    if signet:
        text += f"\n{SIGNET_HINT}"
    return text


def main(argv: list[str]) -> int:
    datadir: Path | None = None
    rpcport: int | None = None
    network: str | None = None
    challenge: str | None = None
    cookiefile: str | None = None
    named = False
    use_stdin = False
    positional: list[str] = []
    i = 1
    while i < len(argv):
        a = argv[i]
        if a == "-stdin":
            use_stdin = True
            i += 1
            continue
        if a == "-named":
            named = True
            i += 1
            continue
        if a == "-nonamed":
            named = False
            i += 1
            continue
        if a.startswith("-"):
            k, v = parse_kv(a)
            if k == "datadir":
                datadir = Path(v or "")
            elif k == "rpcport" and v:
                rpcport = int(v)
            elif k in ("signet", "regtest") and is_on(v):
                network = k
            elif k == "chain" and v:
                network = v
            elif k == "signetchallenge":
                challenge = v or ""
            elif k == "rpccookiefile" and v:
                cookiefile = v
            i += 1
            continue
        positional.append(a)
        i += 1

    if use_stdin:
        extra = sys.stdin.read().splitlines()
        positional.extend(x for x in extra if x)

    if not positional:
        print("too few parameters (need at least command)", file=sys.stderr)
        return 1
    if datadir is None:
        env = os.environ.get("BITCOIN_DATA")
        datadir = Path(env) if env else Path.home() / ".bitcoin"
    if not datadir.is_dir():
        print(f"error: -datadir {datadir} is not a directory", file=sys.stderr)
        return 1

    if rpcport is None:
        v = conf_value(datadir, "rpcport")
        if v:
            rpcport = int(v)
    if rpcport is None:
        print("error: no rpcport", file=sys.stderr)
        return 1

    method = positional[0]
    args = positional[1:]
    if named:
        params: dict | list = {}
        for a in args:
            if "=" not in a:
                print(f"error: named argument expected, got {a!r}", file=sys.stderr)
                return 1
            k, v = a.split("=", 1)
            try:
                params[k] = json.loads(v)
            except json.JSONDecodeError:
                params[k] = v
    else:
        params = []
        for a in args:
            try:
                params.append(json.loads(a))
            except json.JSONDecodeError:
                params.append(a)

    if network is None:
        network = "signet" if is_on(conf_value(datadir, "signet") or "0") else "regtest"
    cookie = cookie_auth(datadir, chain_dir(network, challenge), cookiefile)
    cookie_read = cookie is not None
    password = False
    if cookie is None:
        user = conf_value(datadir, "rpcuser") or ""
        rpcpassword = conf_value(datadir, "rpcpassword")
        if rpcpassword:
            cookie = f"{user}:{rpcpassword}"
            password = True
    body = json.dumps({"jsonrpc": "1.0", "id": "cli", "method": method, "params": params}).encode()
    req = urllib.request.Request(
        f"http://127.0.0.1:{rpcport}/",
        data=body,
        headers={"Content-Type": "application/json"},
        method="POST",
    )
    if cookie:
        import base64

        tok = base64.b64encode(cookie.encode()).decode()
        req.add_header("Authorization", f"Basic {tok}")
    try:
        with urllib.request.urlopen(req, timeout=120) as resp:
            raw = resp.read().decode()
    except urllib.error.HTTPError as e:
        if e.code == 401:
            text = auth_failed(datadir, cookie_read, password, network == "signet")
            print(f"error: {text}", file=sys.stderr)
            return 1
        raw = e.read().decode() if e.fp else ""
        if not raw:
            print(f"error: {e}", file=sys.stderr)
            return 1
        try:
            json.loads(raw)
        except json.JSONDecodeError:
            text = raw if raw.endswith("\n") else raw + "\n"
            print(f"error: Server response: {text}", end="", file=sys.stderr)
            return 1
    except OSError as e:
        print(f"error: {e}", file=sys.stderr)
        return 1

    try:
        msg = json.loads(raw)
    except json.JSONDecodeError:
        print(raw)
        return 0
    if msg.get("error"):
        err = msg["error"]
        code = err.get("code", -1)
        message = err.get("message", "")
        print(f"error code: {code}\nerror message:\n{message}", file=sys.stderr)
        return 1
    result = msg.get("result")
    if result is None:
        return 0
    print(json.dumps(result, default=str))
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
